<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>FeltnerAINative.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'arm64'">win-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <KotlinSharedTask>linkDebugSharedMingwX64</KotlinSharedTask>
    <KotlinSharedDll>$(MSBuildThisFileDirectory)..\shared\build\bin\mingwX64\debugShared\FeltnerAINativeShared.dll</KotlinSharedDll>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <KotlinSharedTask>linkReleaseSharedMingwX64</KotlinSharedTask>
    <KotlinSharedDll>$(MSBuildThisFileDirectory)..\shared\build\bin\mingwX64\releaseShared\FeltnerAINativeShared.dll</KotlinSharedDll>
  </PropertyGroup>

  <Target Name="BuildKotlinSharedBackend" BeforeTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\scripts\gradle-with-jdk.ps1&quot; :shared:$(KotlinSharedTask)" />
    <Copy SourceFiles="$(KotlinSharedDll)" DestinationFolder="$(OutDir)" />
  </Target>
</Project>
